# LLM
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Browser
BROWSER_TIMEOUT=30000
MAX_PAGES_PER_REQUEST=5
HEADLESS=true

# Security
ALLOWED_DOMAINS=
BLOCKED_DOMAINS=
SANDBOX_MODE=true

# Server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=*

# Output
SCREENSHOTS_DIR=./screenshots
