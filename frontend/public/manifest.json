{
  "name": "Нексо",
  "short_name": "Нексо",
  "description": "Secure end-to-end encrypted messenger with Signal Protocol, AI features, and bots",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0a0a0f",
  "theme_color": "#7B61FF",
  "orientation": "portrait-primary",
  "scope": "/",
  "icons": [
    {
      "src": "/logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["social", "communication", "productivity"],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "Новое сообщение",
      "short_name": "Новое",
      "description": "Начать новый диалог",
      "url": "/?action=new",
      "icons": [{ "src": "/logo.png", "sizes": "96x96" }]
    },
    {
      "name": "Избранное",
      "short_name": "Избранное",
      "description": "Открыть избранный чат",
      "url": "/?chat=favorites",
      "icons": [{ "src": "/logo.png", "sizes": "96x96" }]
    },
    {
      "name": "Статистика",
      "short_name": "Статистика",
      "description": "Просмотреть статистику",
      "url": "/?view=statistics",
      "icons": [{ "src": "/logo.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["image/*", "video/*", "audio/*", "application/pdf"]
        }
      ]
    }
  },
  "prefer_related_applications": false,
  "related_applications": [],
  "protocol_handlers": [
    {
      "protocol": "web+нексо",
      "url": "/?нексо=%s"
    }
  ],
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "edge_side_panel": {
    "preferred_width": 400
  }
}
