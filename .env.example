DATABASE_URL="nexo.db"
# SQLite — файл БД в корне проекта. Для PostgreSQL: "postgresql://user:pass@localhost:5432/dbname"

JWT_SECRET="CHANGE_ME_TO_RANDOM_64_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_TO_RANDOM_64_CHARS"
CORS_ORIGINS="http://localhost:6023,http://localhost:3000"

# Encryption (AES-256-GCM)
ENCRYPTION_KEY="CHANGE_ME_TO_RANDOM_64_HEX_CHARS"

# CSRF Protection
CSRF_SECRET="CHANGE_ME_TO_RANDOM_64_HEX_CHARS"

# File Encryption (AES-256-GCM, separate from content encryption)
FILE_ENCRYPTION_KEY="CHANGE_ME_TO_RANDOM_64_HEX_CHARS"

# TURN Server (coturn) — для видеозвонков за NAT
TURN_URL="turn:your-server-ip:3478?transport=udp"
TURN_SECRET="your-turn-secret-here"
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"

# YooKassa (тестовые ключи)
YUKASSA_SHOP_ID=""
YUKASSA_SECRET_KEY=""
YUKASSA_WEBHOOK_SECRET=""

# Frontend URL for payment redirects
FRONTEND_URL="http://localhost:6023"

# Admin panel
ADMIN_PASSWORD="CHANGE_ME_TO_STRONG_PASSWORD"

# AI Proxy (Cloudflare Worker)
AI_PROXY_URL=""
AI_PROXY_SECRET=""

# Gmail SMTP (email verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="Nexo"

# ─── Cloudflare Services ────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME=""
CLOUDFLARE_R2_PUBLIC_URL=""
